<UserControl x:Class="Arctos.Nodes.Wpf.Views.Documents.NodeDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:documentViewModels="clr-namespace:Arctos.Nodes.Wpf.ViewModels.Documents"
             Background="{StaticResource Grey10Brush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />

        <Style x:Key="NavLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontStyle="{TemplateBinding FontStyle}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Text="{TemplateBinding Content}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Foreground" Value="{DynamicResource AccentL80Brush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type documentViewModels:NavLinkVM}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Separator"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center"
                           Text=">" />
                <Button x:Name="LabelButton"
                        Padding="0"
                        VerticalAlignment="Center"
                        Content="{Binding Label}"
                        Style="{StaticResource NavLinkButton}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                    <Setter TargetName="Separator"
                            Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="LabelButton"
                            Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Margin=" 8 8, 8 0"
                MinHeight="22">
            <DockPanel Background="{StaticResource Grey10Brush}">
                <ToggleButton DockPanel.Dock="Right"
                              Padding="8 2"
                              Content="Detailed View"
                              Visibility="{Binding ShowDetailedViewToggle, Converter={StaticResource Bool2Vis}}"
                              IsChecked="{Binding CurrentCanvas.DetailedView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ToolBarToggleButtonStyle}" />
                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding NavLinks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Border Margin="8"
                Background="{StaticResource Grey10Brush}"
                BorderBrush="{StaticResource Grey30Brush}"
                BorderThickness="1">
            <ContentPresenter Content="{Binding CurrentCanvas}" />
        </Border>
    </DockPanel>
</UserControl>
