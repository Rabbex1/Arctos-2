<UserControl x:Class="Arctos.Nodes.Wpf.Views.NodeMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:attachedProperties="clr-namespace:Arctos.Wpf.AttachedProperties;assembly=Arctos.Wpf"
             xmlns:nodeViewModels="clr-namespace:Arctos.Nodes.Wpf.ViewModels"
             xmlns:valueConverters="clr-namespace:Arctos.Wpf.ValueConverters;assembly=Arctos.Wpf">
    <UserControl.Resources>
        <valueConverters:NotBoolToVisibilityConverter x:Key="NotBoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8"
                BorderBrush="#3A3F44"
                BorderThickness="1">
            <ContentPresenter Content="{Binding Settings.PropertiesForm}"
                              attachedProperties:SelectedItem.Highlight="None" />
        </Border>

        <GroupBox Grid.Row="2"
                  Style="{StaticResource FlatGroupBox}"
                  Header="Node Map">
            <TreeView BorderThickness="0"
                      ItemsSource="{Binding Children}"
                      SelectedItemChanged="OnTreeSelectedItemChanged"
                      attachedProperties:SelectedItem.Highlight="Outline" >
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type nodeViewModels:NodeLibraryVM}"
                                              ItemsSource="{Binding Children}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding AddDefinitionCommand}"
                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                    Visibility="{Binding IsExternal, Converter={StaticResource NotBoolToVisibilityConverter}}"
                                    Width="20"
                                    Height="20"
                                    Margin="6,0, 6,0"
                                    Padding="0"
                                    ToolTip="Add definition">
                                <ContentPresenter Content="{StaticResource ArctosWpf:PlusIcon}" />
                            </Button>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#A0A0A0"
                                       Text="{Binding Version}" />
                            <TextBlock FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Text="{Binding DisplayName}" />
                        </DockPanel>
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type nodeViewModels:NodeGraphVM}"
                                              ItemsSource="{Binding Children}">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding DisplayName}" />
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type nodeViewModels:NodeReferencesVM}"
                                              ItemsSource="{Binding Children}">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding DisplayName}" />
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type nodeViewModels:CompositeNodeVM}"
                                              ItemsSource="{Binding Children}">
                        <DockPanel Margin="0 0 6 0"
                                   LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="#A0A0A0"
                                       Text="{Binding NodeId}" />
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding DisplayName}" />
                        </DockPanel>
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type nodeViewModels:NodeInstanceVM}"
                                              ItemsSource="{Binding Children}">
                        <DockPanel Margin="0 0 6 0"
                                   LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="#A0A0A0"
                                       Text="{Binding NodeId}" />
                            <TextBlock Text="{Binding DisplayName}" />
                        </DockPanel>
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type nodeViewModels:NodeDefinitionVM}">
                        <DockPanel Margin="0 0 6 0"
                                   LastChildFill="True">
                            <DockPanel.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Delete"
                                              Command="{Binding DeleteCommand}">
                                        <MenuItem.Icon>
                                            <ContentPresenter Content="{StaticResource ArctosWpf:DeleteIcon}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DockPanel.ContextMenu>
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="#A0A0A0"
                                       Text="{Binding DomainType}" />
                            <TextBlock Text="{Binding DisplayName}" />
                        </DockPanel>
                    </DataTemplate>
                </TreeView.Resources>

                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}"
                           BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="attachedProperties:SelectedItem.Highlight"
                                Value="Outline" />
                        <Setter Property="IsExpanded"
                                Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected"
                                Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectable}"
                                         Value="False">
                                <Setter Property="attachedProperties:SelectedItem.Highlight"
                                        Value="None" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </GroupBox>
    </Grid>
</UserControl>
