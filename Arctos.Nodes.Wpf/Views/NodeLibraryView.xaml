<UserControl x:Class="Arctos.Nodes.Wpf.Views.NodeLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:attachedProperties="clr-namespace:Arctos.Wpf.AttachedProperties;assembly=Arctos.Wpf"
             xmlns:nodeViewModels="clr-namespace:Arctos.Nodes.Wpf.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8"
                BorderBrush="#3A3F44"
                BorderThickness="1">
            <ContentPresenter Content="{Binding PropertiesForm}"
                              attachedProperties:SelectedItem.Highlight="None" />
        </Border>

        <GroupBox Grid.Row="2"
                  Style="{StaticResource FlatGroupBox}">
            <GroupBox.Header>Definitions</GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           LastChildFill="False"
                           Background="{StaticResource TreeViewBackgroundBrush}">
                    <Button DockPanel.Dock="Right"
                            Margin="0, 0, 6, 4"
                            Command="{Binding AddDefinitionCommand}"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                            Width="20"
                            Height="20"
                            Padding="0"
                            ToolTip="Add definition">
                        <ContentPresenter Content="{StaticResource ArctosWpf:PlusIcon}" />
                    </Button>
                </DockPanel>

                <TreeView Grid.Row="1"
                          BorderThickness="0"
                          ItemsSource="{Binding Children}"
                          SelectedItemChanged="OnTreeSelectedItemChanged">
                    <TreeView.Resources>
                        <DataTemplate DataType="{x:Type nodeViewModels:NodeDefinitionVM}">
                            <DockPanel Margin="0 0 6 0"
                                       LastChildFill="True">
                                <DockPanel.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Delete"
                                                  Command="{Binding DeleteCommand}">
                                            <MenuItem.Icon>
                                                <ContentPresenter Content="{StaticResource ArctosWpf:DeleteIcon}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <TextBlock DockPanel.Dock="Right"
                                           Foreground="#A0A0A0"
                                           Text="{Binding DomainType}" />
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DisplayName}" />
                            </DockPanel>
                        </DataTemplate>
                    </TreeView.Resources>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}"
                               BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="attachedProperties:SelectedItem.Highlight"
                                    Value="Outline" />
                            <Setter Property="IsExpanded"
                                    Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected"
                                    Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectable}"
                                             Value="False">
                                    <Setter Property="attachedProperties:SelectedItem.Highlight"
                                            Value="None" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
