    <DataTemplate DataType="{x:Type inputs:InputFormVM}">
        <ListBox ItemsSource="{Binding Inputs}"
                 SelectedItem="{Binding SelectedInput}"
                 Background =" Transparent"
                 BorderThickness="0"
                 attached:SelectedItem.Highlight="{Binding Path=(attached:SelectedItem.Highlight), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ContentPresenter}}}"
                 Margin="0 4 0 0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Grid.IsSharedSizeScope="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Visibility" Value="{Binding Hide, Converter={StaticResource NotBool2Vis}}"/>
                    <Setter Property="attached:SelectedItem.Highlight" Value="{Binding Path=(attached:SelectedItem.Highlight),
                            RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}}"></Setter>
                    <Setter Property="attached:SelectListboxItemByControl.Enable" Value="True"></Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentPresenter ContentTemplateSelector="{StaticResource ParameterSelector}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ListBox>
    </DataTemplate>
</ResourceDictionary>
