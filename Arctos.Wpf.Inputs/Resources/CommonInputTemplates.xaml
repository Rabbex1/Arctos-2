<ResourceDictionary x:Class="Arctos.Wpf.Inputs.Resources.CommonInputTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Arctos.Wpf.Behaviors;assembly=Arctos.Wpf"
                    xmlns:local="clr-namespace:Arctos.Wpf.Inputs;assembly=Arctos.Wpf.Input"
                    xmlns:valueConverters="clr-namespace:Arctos.Wpf.ValueConverters;assembly=Arctos.Wpf"
                    xmlns:markupExtensions="clr-namespace:Arctos.Wpf.MarkupExtensions;assembly=Arctos.Wpf"
                    xmlns:attached="clr-namespace:Arctos.Wpf.AttachedProperties;assembly=Arctos.Wpf"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:colorPicker="clr-namespace:ColorPicker;assembly=ColorPicker"
                    xmlns:inputs="clr-namespace:Arctos.Wpf.Inputs"
                    xmlns:selectors="clr-namespace:Arctos.Wpf.Inputs.Selectors">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ColorPicker;component/Styles/DefaultColorPickerStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <valueConverters:BoolToVisibilityConverter x:Key="Bool2Vis"/>
    <valueConverters:NotBoolToVisibilityConverter x:Key="NotBool2Vis"/>
    <valueConverters:NotNullToVisibilityConverter x:Key="NotNull2Vis"/>
    <valueConverters:NotValueToVisibilityConverter x:Key="NotVal2Vis"/>
    <valueConverters:StringToResourceConverter x:Key="String2Resource"/>
    <valueConverters:TimeSpanToStringConverter x:Key="TimeSpan2String"/>
    <valueConverters:DatePickerConverter x:Key="DateToString"/>




    <Style x:Key="InputTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="behaviors:InputBinding.UpdateOnEnter" Value="TextBox.Text"></Setter>
        <Setter Property="Height" Value="22"/>
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="true">
                <Setter Property="BorderBrush" Value="{StaticResource MenuIconRedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--- Inputs -->

    <DataTemplate DataType="{x:Type inputs:InputStringVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                 IsReadOnly="{Binding IsReadOnly}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputTextAreaVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                 IsReadOnly="{Binding IsReadOnly}"
                 Height="96"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputLabelVM}">
        <TextBlock Text="{Binding Value}"
                   VerticalAlignment="Center"
                   TextAlignment="{Binding Justify}"
                   TextWrapping="Wrap"
                   Margin="0 2"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputIntegerVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 IsReadOnly="{Binding IsReadOnly}">
            <Validation.ErrorTemplate>
                <ControlTemplate />
            </Validation.ErrorTemplate>
            <TextBox.Text>
                <Binding Path="Value"
                         UpdateSourceTrigger="LostFocus">
                    <Binding.ValidationRules>
                        <inputs:StringToIntValidationRule ValidationStep="CommittedValue"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputUnsignedIntegerVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 IsReadOnly="{Binding IsReadOnly}">
            <Validation.ErrorTemplate>
                <ControlTemplate />
            </Validation.ErrorTemplate>
            <TextBox.Text>
                <Binding Path="Value"
                         UpdateSourceTrigger="LostFocus">
                    <Binding.ValidationRules>
                        <inputs:StringToUIntValidationRule ValidationStep="CommittedValue"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputDoubleVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 IsReadOnly="{Binding IsReadOnly}">
            <Validation.ErrorTemplate>
                <ControlTemplate />
            </Validation.ErrorTemplate>
            <TextBox.Text>
                <Binding Path="Value"
                         UpdateSourceTrigger="LostFocus">
                    <Binding.ValidationRules>
                        <inputs:StringToDoubleValidationRule ValidationStep="RawProposedValue"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputFloatVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 IsReadOnly="{Binding IsReadOnly}">
            <Validation.ErrorTemplate>
                <ControlTemplate />
            </Validation.ErrorTemplate>
            <TextBox.Text>
                <Binding Path="Value"
                         UpdateSourceTrigger="LostFocus">
                    <Binding.ValidationRules>
                        <inputs:StringToFloatValidationRule ValidationStep="RawProposedValue"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputEnumVM}">
        <ComboBox Height="22" 
                  ItemsSource="{Binding Path=Value, Converter={markupExtensions:EnumToCollectionConverter}, Mode=OneTime}"
                  DisplayMemberPath="Description"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding Value}">
            <ComboBox.Style>
                <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
        </ComboBox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputStringComboVM}">
        <ComboBox Height="22" 
                  ItemsSource="{Binding Options, Mode=OneTime}"
                  SelectedItem="{Binding Value}">
            <ComboBox.Style>
                <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
            <ComboBox.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource  UrsaComboBoxItemContainerStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding }" Value="-">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                        <Separator HorizontalAlignment="Stretch" IsEnabled="False" Margin="4, 8, 4 , 4"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputObjectComboVM}">
        <ComboBox Height="22" 
                  ItemsSource="{Binding Options, Mode=OneTime}"
                  SelectedItem="{Binding Value}"
                  DisplayMemberPath="{Binding DisplayMember}">
            <ComboBox.Style>
                <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
        </ComboBox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputStringListBoxVM}">
        <Grid Margin="0 2">
            <ListBox ItemsSource="{Binding Options, Mode=OneTime}"
                     SelectedValue="{Binding Value}"
                     Visibility="{Binding IsReadOnly, Converter={StaticResource NotBool2Vis}}">
            </ListBox>
            <ItemsControl ItemsSource="{Binding Options, Mode=OneTime}"
                          Padding="0 0 0 2"
                          Background="{StaticResource TextBoxBackgroundBrush}"
                          Visibility="{Binding IsReadOnly, Converter={StaticResource Bool2Vis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding Mode=OneTime}" IsReadOnly="True"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputStringListVM}">
        <Grid Margin="0 2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 0 0 4">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolBarButtonBaseStyle}">
                        <Setter Property="Width" Value="22"/>
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="Margin" Value="0 0 2 0"/>
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>

                <Button Content="+"
                        Command="{Binding AddCommand}"/>
                <Button Content="-"
                        Command="{Binding RemoveCommand}"
                        IsEnabled="{Binding CanRemove}"/>
                <Button Content="^"
                        Command="{Binding MoveUpCommand}"
                        IsEnabled="{Binding CanMoveUp}"/>
                <Button Content="v"
                        Margin="0"
                        Command="{Binding MoveDownCommand}"
                        IsEnabled="{Binding CanMoveDown}"/>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     attached:SelectedItem.Highlight="Outline"
                     MinHeight="72">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="attached:SelectedItem.Highlight" Value="{Binding Path=(attached:SelectedItem.Highlight),
                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}}"></Setter>
                        <Setter Property="attached:SelectListboxItemByControl.Enable" Value="True"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0 1"
                                 IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputNamedColorListVM}">
        <Grid Margin="0 2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 0 0 4">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolBarButtonBaseStyle}">
                        <Setter Property="Width" Value="22"/>
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="Margin" Value="0 0 2 0"/>
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>

                <Button Content="+"
                        Command="{Binding AddCommand}"/>
                <Button Content="-"
                        Command="{Binding RemoveCommand}"
                        IsEnabled="{Binding CanRemove}"/>
                <Button Content="^"
                        Command="{Binding MoveUpCommand}"
                        IsEnabled="{Binding CanMoveUp}"/>
                <Button Content="v"
                        Margin="0"
                        Command="{Binding MoveDownCommand}"
                        IsEnabled="{Binding CanMoveDown}"/>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     attached:SelectedItem.Highlight="Outline"
                     MinHeight="72">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="attached:SelectedItem.Highlight" Value="{Binding Path=(attached:SelectedItem.Highlight),
                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}}"></Setter>
                        <Setter Property="attached:SelectListboxItemByControl.Enable" Value="True"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Style="{StaticResource InputTextBox}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0 0 6 0"
                                     IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>

                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource ToolWindowBorderBrush}"
                                    BorderThickness="1"
                                    Width="112">
                                <colorPicker:PortableColorPicker SmallChange="5"
                                                                 SelectedColor="{Binding Color, Mode=TwoWay}"
                                                                 ShowAlpha="True">
                                    <colorPicker:PortableColorPicker.Style>
                                        <Style TargetType="{x:Type colorPicker:PortableColorPicker}" BasedOn="{StaticResource DefaultColorPickerStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </colorPicker:PortableColorPicker.Style>
                                </colorPicker:PortableColorPicker>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DataTemplate>

    <!--<DataTemplate DataType="{x:Type local:InputColorVM}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" 
                    BorderBrush="{StaticResource ToolWindowBorderBrush}"
                    BorderThickness="1">
                <Rectangle  Height="22"
                           HorizontalAlignment="Stretch"
                           Fill="{Binding Brush}"/>
            </Border>
        </Grid>
    </DataTemplate>-->


    <DataTemplate DataType="{x:Type inputs:InputColorVM}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" 
                    BorderBrush="{StaticResource ToolWindowBorderBrush}"
                    BorderThickness="1">
                <colorPicker:PortableColorPicker Style="{StaticResource DefaultColorPickerStyle}" SmallChange="5"
                                                 SelectedColor="{Binding Value, Mode=TwoWay}"
                                                 ShowAlpha="True"/>
            </Border>
        </Grid>
    </DataTemplate>



    <DataTemplate DataType="{x:Type inputs:InputFilePathVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 Text="{Binding FileName, UpdateSourceTrigger=LostFocus}"
                 IsReadOnly="{Binding IsReadOnly}"
                 behaviors:InputBinding.UpdateOnEnter="TextBox.Text"
                 ToolTip="{Binding Value}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputFolderVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 Text="{Binding FolderName, UpdateSourceTrigger=LostFocus}"
                 IsReadOnly="{Binding IsReadOnly}"
                 behaviors:InputBinding.UpdateOnEnter="TextBox.Text"
                 ToolTip="{Binding Value.FullName}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputBoolVM}">
        <CheckBox IsChecked="{Binding Value}"
                  VerticalAlignment="Center"
                 behaviors:InputBinding.UpdateOnEnter="TextBox.Text"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputInfinityIntVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 IsReadOnly="{Binding IsReadOnly}">
            <Validation.ErrorTemplate>
                <ControlTemplate />
            </Validation.ErrorTemplate>
            <TextBox.Text>
                <Binding Path="StringValue"
                         UpdateSourceTrigger="LostFocus">
                    <Binding.ValidationRules>
                        <inputs:StringToInfinityIntValidationRule ValidationStep="CommittedValue"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    </DataTemplate>

    <Style x:Key="styleCalendar" TargetType="{x:Type Calendar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <!-- Wrapping in ViewBox will enlarge calendar of that size.-->
                    <Viewbox Height="400"
                             Width="400">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"/>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type inputs:InputDateTimeVM}">
        <DatePicker BorderThickness="0" 
                    SelectedDate="{Binding DateTimeString, FallbackValue={x:Static sys:DateTime.Today}}">
            <DatePicker.CalendarStyle>
                <Style TargetType="{x:Type Calendar}">
                    <Setter Property="Background" Value="{StaticResource ToolWindowBackgroundBrush}" />
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Width" Value="300"></Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Calendar}">
                                <!-- Wrapping in ViewBox will enlarge calendar of that size.-->
                                <Viewbox Height="300"
                                         Width="300">
                                    <CalendarItem x:Name="PART_CalendarItem"
                                                  Background="{TemplateBinding Background}"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"/>
                                </Viewbox>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                </Style>
            </DatePicker.CalendarStyle>
            <DatePicker.Resources>
                <Style TargetType="{x:Type DatePickerTextBox}">
                    <Setter Property="Height" Value="22"></Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <TextBox x:Name="PART_TextBox"
                                         VerticalContentAlignment="Center"
                                         Height="22"
                                         BorderThickness="1"
                                         Text="{Binding DateTimeString}"  />
                            </ControlTemplate>
                            <!--Text="{Binding SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, Converter={StaticResource DateToString}, ConverterParameter='dd/MM/yyyy hh:mm tt'}"  />-->
                        </Setter.Value>
                    </Setter>
                </Style>
            </DatePicker.Resources>
        </DatePicker>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputTimeSpanVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 IsReadOnly="{Binding IsReadOnly}">
            <Validation.ErrorTemplate>
                <ControlTemplate />
            </Validation.ErrorTemplate>
            <TextBox.Text>
                <Binding Path="Value"
                         UpdateSourceTrigger="LostFocus">
                    <Binding.ValidationRules>
                        <inputs:StringToTimeSpanValidationRule ValidationStep="RawProposedValue"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    </DataTemplate>

    <DataTemplate x:Key="InputMatrixTemplate">
        <Grid Margin="0 2"
              IsEnabled="{Binding IsEnabled}">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding Rows}"
                                     Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Margin="4 2"
                                 IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
                            <TextBox.Text>
                                <Binding Path="Text"
                                         UpdateSourceTrigger="LostFocus"/>
                            </TextBox.Text>
                        </TextBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputGroupVM}">
        <ContentPresenter Content="{Binding PropertiesForm}"
                          attached:SelectedItem.Highlight = "None"
                          Margin="0 -8 -4 0"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputFloatRangeVM}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="RangeMin" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition SharedSizeGroup="RangeMax" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" DockPanel.Dock="Left" 
                       VerticalAlignment="Center"
                       Text="{Binding Value.Min}"
                       TextAlignment="Right"/>
            <Slider Grid.Column="1" DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Minimum="{Binding Value.Min}" 
                    Maximum="{Binding Value.Max}"
                    Value="{Binding Value.Value}"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Stretch"  
                    AutoToolTipPlacement="TopLeft"
                    AutoToolTipPrecision="2"
                    Margin="8,0"/>
           <TextBlock Grid.Column="2" DockPanel.Dock="Right"
                      VerticalAlignment="Center"
                      Text="{Binding Value.Max}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputIntRangeVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 IsReadOnly="{Binding IsReadOnly}">
            <Validation.ErrorTemplate>
                <ControlTemplate />
            </Validation.ErrorTemplate>
            <TextBox.Text>
                <Binding Path="StringValue"
                         UpdateSourceTrigger="LostFocus">
                    <Binding.ValidationRules>
                        <inputs:StringToIntRangeValidationRule ValidationStep="CommittedValue"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inputs:InputIntRangeExtraVM}">
        <TextBox Style="{StaticResource InputTextBox}"
                 IsReadOnly="{Binding IsReadOnly}"
                 ToolTip="{Binding AllowedValuesDescription}">
            <Validation.ErrorTemplate>
                <ControlTemplate />
            </Validation.ErrorTemplate>
            <TextBox.Text>
                <Binding Path="StringValue"
                         UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <inputs:StringToIntRangeExtraValidationRule ValidationStep="CommittedValue"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    </DataTemplate>




<!-- Input Form -->

    <selectors:InputTemplateSelector x:Key="InputSelector"/>
    <selectors:ParameterTemplateSelector x:Key="ParameterSelector"/>

    <DataTemplate x:Key="ParameterLabelInput">
        <Grid Margin="4 0">
            <ContentPresenter Content="{Binding }"
                              HorizontalAlignment="Stretch"
                              ContentTemplateSelector="{StaticResource InputSelector}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ParameterInput">
        <Grid Margin="4 0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="LabelColumn" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition SharedSizeGroup="ButtonColumn" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" 
                   VerticalAlignment="Center"
                   Content="{Binding Description}" 
                   Padding="0 5" 
                   Margin="0 0 8 0"/>
            <ContentPresenter Grid.Column="1" 
                              Grid.ColumnSpan="{Binding ValueColumnSpan}" 
                              Content="{Binding }"
                              HorizontalAlignment="Stretch"
                              ContentTemplateSelector="{StaticResource InputSelector}">
            </ContentPresenter>
            <Button Grid.Column="2" Margin="8 2 0 2" 
                    Width="26" Height="22"
                    Visibility="{Binding Icon, Converter={StaticResource NotNull2Vis}}"
                    Command="{Binding ChangeButtonCommand}">
                <ContentPresenter Content="{Binding Icon, Converter={StaticResource String2Resource}}"/>
            </Button>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ParameterMatrixInput">
        <Grid Margin="4 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="LabelColumn" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition SharedSizeGroup="ButtonColumn" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0"
                   VerticalAlignment="Top"
                   Content="{Binding Description}"
                   Padding="0 5"
                   Margin="0 0 8 0"
                   MaxWidth="180">
                <Label.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </Label.ContentTemplate>
            </Label>
            <ContentPresenter Grid.Column="1"
                              Grid.ColumnSpan="{Binding ValueColumnSpan}"
                              Content="{Binding }"
                              HorizontalAlignment="Stretch"
                              ContentTemplateSelector="{StaticResource InputSelector}" />
            <Button Grid.Column="2" Margin="8 2 0 2"
                    Width="26" Height="22"
                    VerticalAlignment="Top"
                    Visibility="{Binding Icon, Converter={StaticResource NotNull2Vis}}"
                    Command="{Binding ChangeButtonCommand}">
                <ContentPresenter Content="{Binding Icon, Converter={StaticResource String2Resource}}"/>
            </Button>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ParameterGroupInput">
        <Grid>
            <Border Padding="0, 8, 0, 0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Collapsable}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="{Binding Header}"
                               Background="#FF3F3F46"
                               Padding="8 4"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ContentPresenter Content="{Binding}"
                                      HorizontalAlignment="Stretch"
                                      ContentTemplateSelector="{StaticResource InputSelector}" />
                </StackPanel>
            </Border>

            <Expander Header="{Binding Header}"
                      IsExpanded="True"
                      Padding="0, 8, 0, 0">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Collapsable}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>

                <ContentPresenter Content="{Binding}"
                                  HorizontalAlignment="Stretch"
                                  ContentTemplateSelector="{StaticResource InputSelector}" />
            </Expander>
        </Grid>
    </DataTemplate>


