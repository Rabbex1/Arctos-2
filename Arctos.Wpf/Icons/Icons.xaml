    <Style x:Key="IconDisabledStyle" TargetType="{x:Type Viewbox}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="EllipseDisabledStyle" TargetType="{x:Type Ellipse}">
        <Setter Property="Stroke" Value="Black"/>
        <Setter Property="StrokeThickness" Value="0"></Setter>
        <Setter Property="Fill" Value="Black"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="IsDisabled">
                        <Storyboard>
                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Ellipse.Fill).(Color)" Duration="0:0:0">
                                <LinearColorKeyFrame Value="{StaticResource DisabledIconColor}" KeyTime="0" />
                            </ColorAnimationUsingKeyFrames>
                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Ellipse.Stroke).(Color)" Duration="0:0:0">
                                <LinearColorKeyFrame Value="{StaticResource DisabledIconColor}" KeyTime="0" />
                            </ColorAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="IsDisabled" />
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RectangleDisabledStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Stroke" Value="Black"/>
        <Setter Property="StrokeThickness" Value="0"></Setter>
        <Setter Property="Fill" Value="Black"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="IsDisabled">
                        <Storyboard>
                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Rectangle.Fill).(Color)" Duration="0:0:0">
                                <LinearColorKeyFrame Value="{StaticResource DisabledIconColor}" KeyTime="0" />
                            </ColorAnimationUsingKeyFrames>
                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Rectangle.Stroke).(Color)" Duration="0:0:0">
                                <LinearColorKeyFrame Value="{StaticResource DisabledIconColor}" KeyTime="0" />
                            </ColorAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="IsDisabled" />
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

