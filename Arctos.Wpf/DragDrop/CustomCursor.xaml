<Grid x:Class="Ursa.Wpf.DragDrop.CustomCursor"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
       mc:Ignorable="d" 
       d:DesignHeight="64" d:DesignWidth="64">
  <StackPanel Margin="0,12,0,0">
    <ContentPresenter Name="CursorImage"/>    
    <TextBlock Name="CursorText" Text="Link" Foreground="White" TextWrapping="Wrap" MaxWidth="70" TextAlignment="Center">
      <TextBlock.Effect>
        <DropShadowEffect ShadowDepth="0" BlurRadius="2" Color="Black" RenderingBias="Performance"/>
      </TextBlock.Effect>
    </TextBlock>
  </StackPanel>
  <Image Name="NoneIcon" Width="24" Height="24" Source="/Arctos.WPF;Component/Images/None.png" HorizontalAlignment="Center" VerticalAlignment="Top"/>
  <Image Name="LinkIcon" Width="24" Height="24" Source="/Arctos.WPF;Component/Images/Link.png" HorizontalAlignment="Center" VerticalAlignment="Top"/>
  <Image Name="CopyIcon" Width="24" Height="24" Source="/Arctos.WPF;Component/Images/Copy.png" HorizontalAlignment="Center" VerticalAlignment="Top"/>
  <Image Name="MoveIcon" Width="24" Height="24" Source="/Arctos.WPF;Component/Images/Move.png" HorizontalAlignment="Center" VerticalAlignment="Top"/>
</Grid>
