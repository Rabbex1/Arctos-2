<Window x:Class="Arctos.Wpf.Splash.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Astraea Lab Splash"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        Foreground="White"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Topmost="True">

    <Border CornerRadius="12" Padding="30" Background="#FF2A2A2A">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Width="512" Height="341"
                   x:Name="LogoImage"
                   Source="{Binding LogoSource, RelativeSource={RelativeSource AncestorType=Window}}"
                   Margin="0, 0, 0, 24"/>
            <TextBlock x:Name="StatusText" Text="Loading..." FontSize="14" TextAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
