<controls:MetroWindow x:Class="Arctos.Shell.Options.OptionsDialogView"
                      Style="{StaticResource MetroStyle}"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:options="clr-namespace:Arctos.Shell.Options"
                      xmlns:controls="clr-namespace:Arctos.Wpf.Controls;assembly=Arctos.Wpf"
                      mc:Ignorable="d" 
                      ShowCloseButton="True"
                      ShowMaxButton="False"
                      ShowMinButton="False"
                      ShowIconOnTitleBar="False"
                      Title="{Binding DisplayName}"
                      Icon="{x:Null}"
                      Width="800" Height="500"
                      Background="{DynamicResource Grey10Brush}"
                      TitleBackgroundBrush="{DynamicResource AccentBrush}"
                      WindowStartupLocation="CenterOwner">

  <DockPanel>
    <Border  DockPanel.Dock="Bottom" 
             BorderBrush="{DynamicResource ComboBoxBorderBrush}" 
             BorderThickness="0,1,0,0" Margin="16,0">
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" Width="60" Margin="0,16">Cancel</Button>
        <Button DockPanel.Dock="Right"  Command="{Binding OkCommand}" Width="60" Margin="16">Ok</Button>
      </DockPanel>
    </Border>
    <options:OptionsManagerTreeView DockPanel.Dock="Top"/>
  </DockPanel>
</controls:MetroWindow>
