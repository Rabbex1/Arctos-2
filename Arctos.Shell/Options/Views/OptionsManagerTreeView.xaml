<UserControl x:Class="Arctos.Shell.Options.OptionsManagerTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:valueConverters="clr-namespace:Arctos.Wpf.ValueConverters;assembly=Arctos.Wpf"
             xmlns:selectors="clr-namespace:Arctos.Shell.Options.Selectors"
             xmlns:arctos="clr-namespace:Arctos;assembly=Arctos"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:shell="clr-namespace:Arctos.Shell"
             mc:Ignorable="d" 
             FontSize="{Binding FontSize}"
             d:DesignHeight="300" d:DesignWidth="300">
  <UserControl.Resources>
    <selectors:OptionsFormDataTemplateSelector x:Key="OptionsDialogSelector"/>
    <valueConverters:StringToResourceConverter x:Key="String2Resource" />
  </UserControl.Resources>
  <DockPanel>
    <TreeView ItemsSource="{Binding Tree}" 
              Name="OptionsTreeView"
              Background="Transparent"
              Width="200" 
              VerticalAlignment="Stretch" 
              BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource ComboBoxBorderBrush}"
              Margin="10,10,0,10">
      <TreeView.Resources>
        <HierarchicalDataTemplate DataType="{x:Type shell:TreeParentVM}" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal">
            <Label Content="{Binding Content.DisplayName}" Padding="0" />
            <ContentPresenter Content="{Binding Icon, Converter={StaticResource String2Resource}}" VerticalAlignment="Center" Margin="2,0,0,0"/>
          </StackPanel>
        </HierarchicalDataTemplate>
      </TreeView.Resources>
      <TreeView.ItemContainerStyle>
        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
          <Setter Property="IsEnabled" Value="{Binding IsEnabled, Mode=TwoWay}" />
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
      </TreeView.ItemContainerStyle>
      <b:Interaction.Triggers>
        <i:EventTrigger EventName="SelectedItemChanged">
          <i:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}" CommandParameter="{Binding SelectedItem, ElementName=OptionsTreeView}"/>
        </i:EventTrigger>
      </b:Interaction.Triggers>
    </TreeView>
    <ContentPresenter Content="{Binding SelectedPage}" ContentTemplateSelector="{StaticResource OptionsDialogSelector}" DockPanel.Dock="Right" Margin="16"/>
  </DockPanel>
</UserControl>

