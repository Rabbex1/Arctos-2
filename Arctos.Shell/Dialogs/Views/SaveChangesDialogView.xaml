<controls:MetroWindow x:Class="Arctos.Shell.Dialogs.SaveChangesDialogView"
                      Style="{StaticResource MetroStyle}"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:controls="clr-namespace:Arctos.Wpf.Controls;assembly=Arctos.Wpf"
                      xmlns:dialogs="clr-namespace:Arctos.Shell.Dialogs"
                      d:DataContext="{d:DesignInstance Type=dialogs:SaveChangesDialogVM}"
                      mc:Ignorable="d" 
                      ShowCloseButton="True"
                      Title="{Binding DisplayName}"
                      Width="500" Height="300"
                      Background="{DynamicResource Grey10Brush}"
                      TitleBackgroundBrush="{DynamicResource AccentBrush}"
                      WindowStartupLocation="CenterOwner">

	<DockPanel>
		<DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="10,0,10,10">
				<Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" Width="60" Margin="0">Cancel</Button>
				<Button DockPanel.Dock="Right"  Command="{Binding NoCommand}" Width="60" Margin="8,0">No</Button>
				<Button DockPanel.Dock="Right"  Command="{Binding YesCommand}" Width="60" Margin="8,0,0,0">Yes</Button>
			</DockPanel>
		<Grid DockPanel.Dock="Top" Margin="10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition/>
			</Grid.RowDefinitions>
			<TextBlock Margin="0,0,0,10">Save changes to the following documents?</TextBlock>
      <Border Grid.Row="1"
              BorderBrush="{DynamicResource ListBoxBorderBrush}"
              BorderThickness="1"
              Padding="5">
			  <ItemsControl ItemsSource="{Binding Documents}"
									    DisplayMemberPath="DisplayName"/>
       </Border>
		</Grid>
	</DockPanel>
</controls:MetroWindow>
