    <!-- Style for the Chart  -->
    <Style TargetType="{x:Type charts:Chart}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#444444"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type charts:Chart}">
                    <charts:ChartPanel x:Name="PART_ChartArea">
                        <Border Canvas.ZIndex ="100"
                    BorderBrush="#444444" BorderThickness="1"
                    charts:ChartPanel.HorizontalPosition="Center"
                    charts:ChartPanel.VerticalPosition="Center"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
                    </charts:ChartPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>



















