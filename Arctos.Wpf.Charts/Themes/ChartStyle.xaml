<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:charts="clr-namespace:Arctos.Wpf.Charts">

    <Style x:Key="MinorVerticalTick"  TargetType="{x:Type charts:TickSet}">
        <Setter Property="Rank" Value="1"/>
        <Setter Property="Frequency" Value="1"/>
        <Setter Property="IsLabeled" Value="True"/>
        <Setter Property="Glyph">
            <Setter.Value>
                <DataTemplate>
                    <Line X1="0" Y1="0" X2="3" Y2="0"                        
                          StrokeThickness="2"
                          Stroke="#444444"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MajorVerticalTick"  TargetType="{x:Type charts:LinearTicks}">
        <Setter Property="Rank" Value="1"/>
        <Setter Property="Frequency" Value="5"/>
        <Setter Property="IsLabeled" Value="True"/>
        <Setter Property="Glyph">
            <Setter.Value>
                <DataTemplate>
                    <Line X1="0" Y1="0" X2="6" Y2="0"                        
                          StrokeThickness="2"
                          Stroke="#444444"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MinorHorizontalTick"  TargetType="{x:Type charts:LinearTicks}">
        <Setter Property="Rank" Value="1"/>
        <Setter Property="Frequency" Value="1"/>
        <Setter Property="IsLabeled" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="Glyph">
            <Setter.Value>
                <DataTemplate>
                    <Line X1="0" Y1="3" X2="0" Y2="0"                        
                    StrokeThickness="2"
                    Stroke="#444444"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MajorHorizontalTick"  TargetType="{x:Type charts:LinearTicks}">
        <Setter Property="Rank" Value="1"/>
        <Setter Property="Frequency" Value="5"/>
        <Setter Property="IsLabeled" Value="True"/>
        <Setter Property="Glyph">
            <Setter.Value>
                <DataTemplate>
                    <Line X1="0" Y1="6" X2="0" Y2="0"                        
                      StrokeThickness="2"
                      Stroke="#444444"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type charts:DiscreteAxis}">
        <Setter Property="IsScrollable" Value="False"/>
        <Setter Property="IsZoomable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="VerticalDiscreteAxis" TargetType="{x:Type charts:DiscreteAxis}" BasedOn="{StaticResource {x:Type charts:DiscreteAxis}}">
        <Setter Property="charts:ChartPanel.HorizontalPosition" Value="Left"/>
        <Setter Property="charts:ChartPanel.VerticalPosition" Value="Center"/>
    </Style>

    <Style x:Key="HorizontalDiscreteAxis" TargetType="{x:Type charts:DiscreteAxis}" BasedOn="{StaticResource {x:Type charts:DiscreteAxis}}">
        <Setter Property="charts:ChartPanel.HorizontalPosition" Value="Center"/>
        <Setter Property="charts:ChartPanel.VerticalPosition" Value="Bottom"/>
    </Style>



    <Style TargetType="{x:Type charts:NumericAxis}">
        <Setter Property="IsScrollable" Value="False"/>
        <Setter Property="IsZoomable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ShowZero" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="VerticalNumericAxis" TargetType="{x:Type charts:NumericAxis}" BasedOn="{StaticResource {x:Type charts:NumericAxis}}">
        <Setter Property="charts:ChartPanel.HorizontalPosition" Value="Left"/>
        <Setter Property="charts:ChartPanel.VerticalPosition" Value="Center"/>
    </Style>

    <Style x:Key="HorizontalNumericAxis" TargetType="{x:Type charts:NumericAxis}" BasedOn="{StaticResource {x:Type charts:NumericAxis}}">
        <Setter Property="charts:ChartPanel.HorizontalPosition" Value="Center"/>
        <Setter Property="charts:ChartPanel.VerticalPosition" Value="Bottom"/>
    </Style>



    <Style TargetType="{x:Type charts:TimeAxis}">
        <Setter Property="IsScrollable" Value="True"/>
        <Setter Property="IsZoomable" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="HorizontalTimeAxis" TargetType="{x:Type charts:TimeAxis}" BasedOn="{StaticResource {x:Type charts:TimeAxis}}">
        <Setter Property="charts:ChartPanel.HorizontalPosition" Value="Center"/>
        <Setter Property="charts:ChartPanel.VerticalPosition" Value="Bottom"/>
    </Style>


    <Style TargetType="{x:Type charts:UiPresenter}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="charts:ChartPanel.HorizontalPosition" Value="Center"/>
        <Setter Property="charts:ChartPanel.VerticalPosition" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type charts:UiPresenter}">
                    <ContentPresenter Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

