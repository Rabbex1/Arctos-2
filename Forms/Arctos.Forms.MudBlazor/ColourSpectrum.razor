@using global::MudBlazor.Utilities
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="colour-triangle-picker @(CenterFields ? "center-fields" : "")" @ref="_element">
    <div class="colour-wheel">
        <div class="hue-ring" tabindex="0" role="slider" aria-label="Hue" aria-valuemin="0" aria-valuemax="360"></div>
        <canvas class="colour-triangle" tabindex="0" role="slider" aria-label="Colour triangle: hue, white and black"
                aria-valuemin="0" aria-valuemax="100" aria-description="Use arrow keys to move the selection. Shift moves faster."></canvas>
        <span class="hue-marker" aria-hidden="true"></span>
        <span class="colour-marker" aria-hidden="true"></span>
    </div>
    <div class="common-fields">
    <label class="alpha-row">Alpha <input data-channel="alpha" type="range" min="0" max="255" step="1" aria-label="Alpha" /></label>
    <label class="format-row">Format <select data-channel="format" aria-label="Colour format"><option>RGB</option><option>HSV</option><option>HSL</option></select></label>
    <div class="colour-channels">
        <label><span data-label="r">R</span><input data-channel="r" type="number" min="0" max="255" step="1" aria-label="First colour channel" /></label>
        <label><span data-label="g">G</span><input data-channel="g" type="number" min="0" max="255" step="1" aria-label="Second colour channel" /></label>
        <label><span data-label="b">B</span><input data-channel="b" type="number" min="0" max="255" step="1" aria-label="Third colour channel" /></label>
        <label>A<input data-channel="a" type="number" min="0" max="255" step="1" aria-label="Alpha byte" /></label>
    </div>
    <label class="hex-row">Hex <input data-channel="hex" type="text" aria-label="Hex RGBA" maxlength="9" spellcheck="false" /></label>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MudColor Value { get; set; } = new(255, 255, 255, 255);
    [Parameter] public EventCallback<MudColor> ValueChanged { get; set; }
    [Parameter] public bool CenterFields { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _picker;
    private DotNetObjectReference<ColourSpectrum>? _callback;
    private long _revision;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arctos.Forms.MudBlazor/colourTriangle.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _callback = DotNetObjectReference.Create(this);
            _picker = await _module.InvokeAsync<IJSObjectReference>("create", _element, _callback, new[] { (int)Value.R, Value.G, Value.B, Value.A });
            if (_disposed) { await DisposePickerAsync(); return; }
        }
        if (_picker is not null)
            await _picker.InvokeVoidAsync("setColor", new[] { (int)Value.R, Value.G, Value.B, Value.A }, _revision);
    }

    [JSInvokable]
    public async Task SelectColor(int r, int g, int b, int a, long revision)
    {
        if (_disposed || revision < _revision) return;
        _revision = revision;
        var color = new MudColor(Math.Clamp(r, 0, 255), Math.Clamp(g, 0, 255), Math.Clamp(b, 0, 255), Math.Clamp(a, 0, 255));
        await ValueChanged.InvokeAsync(color);
    }

    private async Task DisposePickerAsync()
    {
        if (_picker is not null)
        {
            await _picker.InvokeVoidAsync("dispose");
            await _picker.DisposeAsync();
        }
        if (_module is not null) await _module.DisposeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { await DisposePickerAsync(); }
        catch (JSDisconnectedException) { }
        finally { _callback?.Dispose(); }
    }
}
