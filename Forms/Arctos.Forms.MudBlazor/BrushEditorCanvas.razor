@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
<canvas @ref="_canvas" style="width:240px;height:240px;touch-action:none;cursor:crosshair" aria-label="Brush preview with draggable gradient points"
        title="@(Model.Mode == "Radial" ? "View range changes only the editing view. An edge arrow means the centre is outside the view; increase the range or edit X/Y to reveal it." : null)"></canvas>
@code {
    [Parameter, EditorRequired] public BrushEditingModel Model { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }
    private ElementReference _canvas;
    private IJSObjectReference? _module, _instance;
    private DotNetObjectReference<BrushEditorCanvas>? _callback;
    private bool _disposed;
    private BrushEditingModel.Stop? _dragStop;
    private object State()
    {
        var brush = Model.PreviewDescription();
        var radial = brush as InputRadialGradientBrushDescription;
        var guide = Model.ToPreview(Model.GuideEnd.X, Model.GuideEnd.Y);
        var stops = brush is InputGradientBrushDescription g ? g.Stops : [];
        var solid = brush is InputSolidBrushDescription s ? s.Color : new InputColor(0, 0, 0, 0);
        return new {
            mode = brush.Kind.ToString(), clear = Model.IsClear,
            x1 = radial?.CenterX ?? Model.X1, y1 = radial?.CenterY ?? Model.Y1,
            x2 = radial?.RadiusX ?? Model.X2, y2 = radial?.RadiusY ?? Model.Y2,
            solid = new[] { (int)solid.Red, solid.Green, solid.Blue, solid.Alpha },
            stops = stops.Select(p => new { offset = p.Offset, color = new[] { (int)p.Color.Red, p.Color.Green, p.Color.Blue, p.Color.Alpha } }),
            handles = Model.PreviewHandles(), tool = Model.Tool, guide = new[] { guide.X, guide.Y }, viewScale = Model.PreviewScale
        };
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Arctos.Forms.MudBlazor/brushEditorPreview.js");
            if (_disposed) return;
            _callback = DotNetObjectReference.Create(this);
            _instance = await _module.InvokeAsync<IJSObjectReference>("create", _canvas, _callback);
        }
        if (_instance is not null) await _instance.InvokeVoidAsync("update", State());
    }
    [JSInvokable] public async Task Drag(string id, double x, double y, bool first)
    {
        if (_disposed) return;
        if (first)
        {
            _dragStop = null;
            if (id.StartsWith("stop:") && int.TryParse(id[5..], out var index) && index >= 0 && index < Model.Stops.Count)
            { _dragStop = Model.Stops[index]; Model.Select(index); }
        }
        else
        {
            if (_dragStop is not null) id = $"stop:{Model.Stops.ToList().IndexOf(_dragStop)}";
            Model.MovePreviewHandle(id, x, y);
        }
        await Changed.InvokeAsync();
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try {
            if (_instance is not null) { await _instance.InvokeVoidAsync("dispose"); await _instance.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        } catch (JSDisconnectedException) { }
        _callback?.Dispose();
    }
}
