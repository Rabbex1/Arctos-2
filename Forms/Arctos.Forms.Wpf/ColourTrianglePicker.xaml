<UserControl x:Class="Arctos.Forms.Wpf.ColourTrianglePicker"
             x:Name="Picker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Arctos.Forms.Wpf">
    <StackPanel Width="240" HorizontalAlignment="Center">
        <local:ColourTriangleSurface x:Name="Wheel" Width="240" Height="240" HorizontalAlignment="Center"
            SelectedColor="{Binding SelectedColor, ElementName=Picker, Mode=TwoWay}" />
        <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Alpha" VerticalAlignment="Center" />
            <Slider x:Name="AlphaSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="AlphaChanged" AutomationProperties.Name="Alpha" />
        </Grid>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Format" VerticalAlignment="Center" />
            <ComboBox x:Name="FormatBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="FormatChanged"><ComboBoxItem Content="RGB" /><ComboBoxItem Content="HSV" /><ComboBoxItem Content="HSL" /></ComboBox>
        </Grid>
        <UniformGrid Columns="3">
            <StackPanel Margin="0,0,6,0"><TextBlock x:Name="FirstLabel" Text="R" /><TextBox x:Name="RedBox" AutomationProperties.Name="First colour channel" LostKeyboardFocus="ChannelsChanged" KeyDown="ChannelsKeyDown" /></StackPanel>
            <StackPanel Margin="0,0,6,0"><TextBlock x:Name="SecondLabel" Text="G" /><TextBox x:Name="GreenBox" AutomationProperties.Name="Second colour channel" LostKeyboardFocus="ChannelsChanged" KeyDown="ChannelsKeyDown" /></StackPanel>
            <StackPanel><TextBlock x:Name="ThirdLabel" Text="B" /><TextBox x:Name="BlueBox" AutomationProperties.Name="Third colour channel" LostKeyboardFocus="ChannelsChanged" KeyDown="ChannelsKeyDown" /></StackPanel>
        </UniformGrid>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Hex" VerticalAlignment="Center" />
            <TextBox x:Name="HexBox" Grid.Column="1" AutomationProperties.Name="Hex RGBA" ToolTip="#RRGGBB or #RRGGBBAA"
                     LostKeyboardFocus="HexChanged" KeyDown="HexKeyDown" />
        </Grid>
    </StackPanel>
</UserControl>
