<Window x:Class="Arctos.Forms.Wpf.BrushEditorWindow" x:Name="Editor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Arctos.Forms.Wpf"
        Title="Brush editor" Width="580" Height="520" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EditorSurface}" Foreground="{DynamicResource EditorText}">
    <Window.Resources>
        <SolidColorBrush x:Key="EditorSurface" Color="#F7F6F2" />
        <SolidColorBrush x:Key="EditorText" Color="#202020" />
        <local:InputColorValueConverter x:Key="ColourConverter" />
        <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource EditorSurface}" /><Setter Property="Foreground" Value="{DynamicResource EditorText}" /><Setter Property="Padding" Value="4,2" /></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="9,4" /><Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource EditorText}" /><Setter Property="Background" Value="{DynamicResource EditorSurface}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="#888888" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderThickness" Value="2" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource EditorText}" /><Setter Property="Background" Value="{DynamicResource EditorSurface}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource EditorText}" /><Setter Property="Background" Value="{DynamicResource EditorSurface}" /><Setter Property="MinHeight" Value="26" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource EditorSurface}" BorderBrush="#888888" BorderThickness="1" CornerRadius="3" /></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter IsHitTestVisible="False" Margin="6,3,23,3" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" />
                    <TextBlock Text="▾" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border Background="{DynamicResource EditorSurface}" BorderBrush="#888888" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModeTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Border" Padding="8,6" BorderBrush="Transparent" BorderThickness="0,0,0,2"><ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource EditorText}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#888888" BorderThickness="1" Padding="19,0,19,19">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="19" Background="Transparent" Cursor="SizeAll"
                    ToolTip="Drag to move the brush editor" MouseLeftButtonDown="DragStripMouseDown">
                <Border Width="36" Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Background="{DynamicResource EditorText}" Opacity="0.45" />
            </Border>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="24" /><RowDefinition Height="36" /></Grid.RowDefinitions>
            <UniformGrid x:Name="Tabs" Columns="5">
                <RadioButton Content="Solid" Tag="Solid" GroupName="BrushMode" Style="{StaticResource ModeTab}" Checked="ModeChanged" />
                <RadioButton Content="Linear" Tag="Linear" GroupName="BrushMode" Style="{StaticResource ModeTab}" Checked="ModeChanged" />
                <RadioButton Content="Radial" Tag="Radial" GroupName="BrushMode" Style="{StaticResource ModeTab}" Checked="ModeChanged" />
                <RadioButton Content="Sweep" Tag="Sweep" GroupName="BrushMode" Style="{StaticResource ModeTab}" Checked="ModeChanged" />
                <RadioButton Content="Palette" Tag="Palette" GroupName="BrushMode" Style="{StaticResource ModeTab}" Checked="ModeChanged" />
            </UniformGrid>
            <Grid x:Name="EditingPane" Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="38" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="246" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <local:ColourTriangleSurface Width="240" Height="240" VerticalAlignment="Top" SelectedColor="{Binding EditorColor, ElementName=Editor, Mode=TwoWay}" />
                <local:BrushEditorPreview x:Name="Preview" Grid.Column="2" Width="240" Height="240" VerticalAlignment="Top" />
                <local:ColourTrianglePicker x:Name="Fields" Grid.Row="1" ShowWheel="False" VerticalAlignment="Top" SelectedColor="{Binding EditorColor, ElementName=Editor, Mode=TwoWay}" />
                <StackPanel x:Name="GeometryPanel" Grid.Row="1" Grid.Column="2" Margin="5,6,5,0">
                    <UniformGrid x:Name="Tools" Columns="2" Margin="0,0,0,8">
                        <RadioButton x:Name="PointsTool" Content="Points" GroupName="GeometryTool" Style="{StaticResource ModeTab}" Checked="ToolChanged" />
                        <RadioButton x:Name="OtherTool" Content="Angle" GroupName="GeometryTool" Style="{StaticResource ModeTab}" Checked="ToolChanged" />
                    </UniformGrid>
                    <Grid x:Name="PointRow" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="PointBox" SelectionChanged="PointChanged" HorizontalContentAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><Grid MinWidth="116"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                <Ellipse Grid.Column="1" Width="13" Height="13" Stroke="Gray" StrokeThickness="1"><Ellipse.Fill><SolidColorBrush Color="{Binding Color, Converter={StaticResource ColourConverter}}" /></Ellipse.Fill></Ellipse>
                            </Grid></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="+" Padding="0" Margin="3,0,0,0" ToolTip="Add point" Click="AddPoint" />
                        <Button x:Name="RemoveButton" Grid.Column="2" Padding="0" Margin="3,0,0,0" ToolTip="Delete point" Click="RemovePoint"><Path Width="13" Height="15" Stretch="Fill" Stroke="{DynamicResource EditorText}" StrokeThickness="1.4" Data="M 2,4 L 12,4 M 4,4 L 4,14 L 10,14 L 10,4 M 5,2 L 9,2 M 6,6 L 6,12 M 8,6 L 8,12" /></Button>
                    </Grid>
                    <Grid x:Name="CoordinateRow"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="XBox" Width="86" LostKeyboardFocus="CoordinateChanged" KeyDown="CoordinateKey" /></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="YBox" Width="86" LostKeyboardFocus="CoordinateChanged" KeyDown="CoordinateKey" /></StackPanel>
                    </Grid>
                    <StackPanel x:Name="AngleRow" Orientation="Horizontal"><TextBlock Text="Angle °" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox x:Name="AngleBox" Width="150" LostKeyboardFocus="AngleChanged" KeyDown="AngleKey" /></StackPanel>
                    <Grid x:Name="ViewRangeRow" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                        <TextBlock Text="View range" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="ViewRangeSlider" Grid.Column="1" Minimum="1" Maximum="4" SmallChange="0.1" LargeChange="0.5"
                                VerticalAlignment="Center" ValueChanged="ViewRangeChanged" ToolTip="Zoom out without changing the brush" AutomationProperties.Name="Radial view range" />
                        <TextBlock x:Name="ViewRangeLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
            <ItemsControl x:Name="PalettePane" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Button Margin="4" Click="PaletteClicked" ToolTip="{Binding Name}"><StackPanel><local:BrushPreview Description="{Binding Description}" Width="86" Height="55" /><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="IndianRed" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Grid Grid.Row="3">
                <Button x:Name="ClearButton" Content="Clear / inherit" Click="ClearClicked" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" MinWidth="78" Margin="0,0,8,0" Click="CancelClicked" /><Button x:Name="AcceptButton" Content="Accept" MinWidth="78" Click="AcceptClicked" /></StackPanel>
            </Grid>
        </Grid>
        </DockPanel>
    </Border>
</Window>
